NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Use DATABASE_URL, or the individual DB_* values below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=seaware
DB_PASSWORD=
DB_NAME=se_aware
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=10

# Generate at least 32 random characters. Never commit the real value.
JWT_SECRET=

# Stripe subscription product configuration.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Configure either n8n or Gemini. n8n takes precedence when both are set.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CHAT_RATE_LIMIT=20
